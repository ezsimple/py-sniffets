[Unit]
Description=A1 mini monitoring agent (nginx backend health + telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/py-sniffets/a1_monitoring
ExecStart=/home/ubuntu/.pyenv/versions/머신러닝/bin/python /home/ubuntu/py-sniffets/a1_monitoring/a1_mon.py
Restart=always
RestartSec=10
Environment=CHECK_INTERVAL_SEC=180
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID 는 EnvironmentFile 로 주입
EnvironmentFile=-/home/ubuntu/py-sniffets/a1_monitoring/.env.dev

[Install]
WantedBy=multi-user.target
